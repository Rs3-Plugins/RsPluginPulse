# Shared by packages/db, packages/ingest, and packages/api.
DATABASE_URL=postgres://user:password@localhost:5432/rspluginpulse

# packages/ingest -- posts an embed to this Discord webhook if `npm run
# ingest` or `npm run ingest:runelite` throws, with the error as the
# message. Optional: leave blank to just log the failure to stderr instead.
# Left as an active (uncommented) key, even though blank, so
# deploy/render-env.mjs picks it up and maps it to a GitHub secret --
# anything commented out here is invisible to that script.
DISCORD_WEBHOOK_URL=

# packages/ingest -- only used by the one-time `npm run backfill:releases`
# script (packages/ingest/src/backfill-releases.ts), which walks the
# RuneLite plugin-hub's GitHub commit history to backfill plugin_releases.
# Optional, but unauthenticated GitHub API calls are capped at 60/hour and
# this script needs one call per RuneLite plugin (2,600+) -- set this to a
# plain classic personal access token with no scopes (public repo reads
# only need the higher authenticated rate limit, not any actual access) to
# raise that to 5,000/hour, or the backfill will take many hours.
# Deliberately NOT listed here as PLUGIN_HUB_TOKEN= -- deploy/release.sh
# fully overwrites the server's shared/.env with a freshly rendered one on
# every deploy, so a key declared here with no secret behind it would get
# blanked out again on the next deploy. Set it by hand directly in
# /srv/rspluginpulse/shared/.env on the server instead; it'll survive
# deploys as long as it's not also declared in this file.

# packages/api -- "Log in with Discord" OAuth2 (identify + guilds scopes)
# for the /discord dashboard, see docs/discord-bot.md and
# packages/api/src/lib/discordAuth.ts. From the Discord Developer Portal's
# OAuth2 tab for the PluginPulse application. DISCORD_REDIRECT_URI must be
# registered there too, exactly -- this API's own public URL plus
# /api/discord/oauth/callback (e.g. https://api.rspluginpulse.com/api/
# discord/oauth/callback in prod, http://localhost:3000/api/discord/oauth/
# callback for local dev).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/oauth/callback

# packages/api -- the bot's own token (Developer Portal -> Bot tab -> Reset
# Token), used ONLY to check which guilds the bot is actually a member of
# (GET /users/@me/guilds with Bot auth -- a plain REST call, no running bot
# process/gateway connection needed for this). /api/discord/guilds uses it
# to filter a user's manageable guilds down to ones the bot has actually
# been invited to via /api/discord/oauth/install's "Add to Discord" flow.
DISCORD_BOT_TOKEN=

# packages/api -- comma-separated Discord user ids that always count as
# site-wide admin-panel mods (see authorizeSiteAdminRequest in
# discordAuth.ts and the site_admins table in packages/db/src/schema.sql),
# with no DB row needed. This is the bootstrap for "who can even grant the
# very first mod" -- anyone added through the admin panel itself after
# that is a site_admins row instead.
SITE_OWNER_DISCORD_IDS=

# packages/api -- the web app's own origin, no trailing slash. Used as the
# redirect target after a successful Discord OAuth callback, and as the
# CORS allowlist for the credentialed /api/discord/* session routes (the
# rest of the API stays wildcard-CORS and is unaffected -- credentials and
# `Access-Control-Allow-Origin: *` can't be combined, so those few routes
# need a real origin to echo back instead).
WEB_APP_URL=http://localhost:5173

# packages/discord-bot -- this API's own public origin, no trailing slash
# (distinct from WEB_APP_URL above, which is the dashboard frontend).
# Lets the bot link straight to the existing /api/card/{type}/{id}.png
# stats-card renderer as an embed image (see cardImageUrl in
# packages/discord-bot/src/format.ts). Optional: defaults to
# https://api.rspluginpulse.com, so only needed locally if running the
# bot against a non-default API instance (e.g. http://localhost:3000).
# Left blank (not defaulted here) so deploy/render-env.mjs doesn't render
# that local value into production -- it isn't wired to a GitHub secret,
# so a non-blank default here would otherwise ship to the server as-is on
# every deploy, overriding the code's own prod-correct fallback above.
API_BASE_URL=

# Shared by packages/discord-bot (server) and packages/api (client) --
# the internal, loopback-only bridge that lets the dashboard read
# guild/channel/role data straight from the bot's live Gateway cache
# instead of a fresh Discord REST call every time (packages/discord-bot/
# src/internalServer.ts, packages/api/src/lib/discordAuth.ts's
# internalFetch). Optional: leave DISCORD_BOT_INTERNAL_SECRET blank to
# disable this entirely -- every caller falls straight back to its
# existing REST implementation with no behavior change, so this is safe
# to leave unset while getting everything else running, or on any
# deployment where the two processes can't reach each other over
# loopback. Set the same secret in both processes' env (they already
# share one shared/.env file in production, see deploy/configure.sh) --
# it's a shared bearer credential, not a public value.
DISCORD_BOT_INTERNAL_SECRET=
# Both optional, only needed to change the default loopback port/URL
# (e.g. if 3100 is already taken locally). DISCORD_BOT_INTERNAL_PORT is
# read by the bot (what it listens on); DISCORD_BOT_INTERNAL_URL is read
# by the API (where it connects) and defaults to
# http://127.0.0.1:${DISCORD_BOT_INTERNAL_PORT ?? 3100} if unset, so you
# normally only need to set one or the other, not both.
DISCORD_BOT_INTERNAL_PORT=3100
DISCORD_BOT_INTERNAL_URL=

# packages/api -- embed card cache (packages/api/src/lib/cardCache.ts).
# Optional: leave blank for local dev, which falls back to writing cards
# to packages/api/.cache/cards/ instead. Set all four to switch the cache
# over to a Cloudflare R2 bucket (needed once this runs on more than one
# instance, since the local directory isn't shared).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=cards/
