# Shared by packages/db, packages/ingest, and packages/api.
DATABASE_URL=postgres://user:password@localhost:5432/rspluginpulse

# packages/ingest -- posts an embed to this Discord webhook if `npm run
# ingest` or `npm run ingest:runelite` throws, with the error as the
# message. Optional: leave blank to just log the failure to stderr instead.
# Left as an active (uncommented) key, even though blank, so
# deploy/render-env.mjs picks it up and maps it to a GitHub secret --
# anything commented out here is invisible to that script.
DISCORD_WEBHOOK_URL=

# packages/ingest -- only used by the one-time `npm run backfill:releases`
# script (packages/ingest/src/backfill-releases.ts), which walks the
# RuneLite plugin-hub's GitHub commit history to backfill plugin_releases.
# Optional, but unauthenticated GitHub API calls are capped at 60/hour and
# this script needs one call per RuneLite plugin (2,600+) -- set this to a
# plain classic personal access token with no scopes (public repo reads
# only need the higher authenticated rate limit, not any actual access) to
# raise that to 5,000/hour, or the backfill will take many hours.
# Deliberately NOT listed here as PLUGIN_HUB_TOKEN= -- deploy/release.sh
# fully overwrites the server's shared/.env with a freshly rendered one on
# every deploy, so a key declared here with no secret behind it would get
# blanked out again on the next deploy. Set it by hand directly in
# /srv/rspluginpulse/shared/.env on the server instead; it'll survive
# deploys as long as it's not also declared in this file.

# packages/api -- embed card cache (packages/api/src/lib/cardCache.ts).
# Optional: leave blank for local dev, which falls back to writing cards
# to packages/api/.cache/cards/ instead. Set all four to switch the cache
# over to a Cloudflare R2 bucket (needed once this runs on more than one
# instance, since the local directory isn't shared).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=cards/
